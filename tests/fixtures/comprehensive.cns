; File prelude comment
; <not a section separator>

[Data]
life = 1000

[Statedef 0]
type = S ; State type
ctrl = 1
; Pure comment inside the state
; <ordinary comment>
;

[State 0, Explod]
type = Explod
trigger1 = time = 0
persistent = 2 ; Persistent comment
ignorehitpause = 1 ; Ignore comment
anim = 10
pos = 1, 2
scale = 1, 1

[State 0, PlaySnd]
type = PlaySnd
trigger1 = time = 0
value = 1, 0

; Comment between states
; Another comment between states

[Statedef 10]
type = S

[State 10, TriggerGrouping]
type = ChangeState
trigger3 = C
trigger1 = 1
trigger2 = B
trigger1 = A
trigger3 = D
trigger4 = E
trigger4 = F
value = 20

[State 10, VarSet]
type = VarSet
trigger1 = 1
var(1) = 5 ; Variable comment

[State 10, ParentVarAdd]
type = parentvaradd
trigger1 = 1
var(2) = 1
value = 3

[State 10, DuplicateParameter]
type = DisplayToClipboard
trigger1 = 1
text = "first"
text = "second"

[State 10, AssignmentInParameter]
type = DisplayToClipboard
trigger1 = 1
text = "assignment %d"
params = var(0) := 1

; Pure comment immediately before the next state

[Statedef 20]
type = A
movetype = A
physics = N

[State 20, ModifyExplod]
type = ModifyExplod
trigger1 = 1
id = 1
anim = 2
pos = 0, 0
ignorehitpause = 1

[State 20, AfterImage]
type = AfterImage
trigger1 = 1
time = 2
length = 5
paladd = 1, 2, 3
ignorehitpause = 1

[State 20, OutOfOrderTriggers]
type = ChangeState
trigger2 = B
trigger1 = A
trigger2 = C
trigger1 = D
value = 0

[State 20, EmptyController]
type = Null
trigger1 = 1

[State 20, AngleComment]
type = Null
; Comment containing <angle brackets>
trigger1 = 1

[Statedef 20]
type = C

[Statedef +1]
type = S

; ===== Edge cases found on real characters; see AGENTS.md =====

[Data]
life = 1000
; power = 3000

;===== Banner kept after a removed section =====
[Statedef 200, Punch] ; header comment
type = S
type = A
ctrl = 0

[State 200, Always]
type = Null
trigger1 = 1

[State 200, OrOne]
type = Null
trigger1 = AnimTime = 0
trigger2 = 1

[State 200, AndOne]
type = Null
triggerall = 1
trigger1 = 1
trigger1 = A ; only when A

[State 200, Gap]
type = Null
trigger1 = A
trigger3 = B
trigger = C
trigger0 = D

[State 200, Xor]
type = Null
trigger1 = A ^^ B
trigger1 = C

[State 200, Strings]
type = Null
trigger1 = command = "a (b)" && var (1)

[State 200, Persistent]
type = PlaySnd
triggerall = Ctrl
trigger1 = AnimElem = 3
trigger2 = AnimElem = 5
persistent = 2
ignorehitpause = 1
value = 1,0

[State 200, NoMerge1]
type = VarSet
trigger1 = var(1) = 0
var(1) = 1

[State 200, NoMerge2]
type = VarAdd
trigger1 = var(1) = 0
var(2) = 1

[State 200, Params]
type = PosAdd
type = VelSet
trigger1 = 1
x = 1
;y = 2
z = 3
; closing comment

; Comment above the next header
[State 200, Parent]
type = ParentVarSet
trigger1 = 1
fvar(3) = 1.5

[State 200, Map]
type = MapSet
trigger1 = 1
map(combo) = 5

[State 200, ShortCircuit]
type = Null
trigger1 = 1 || var(5) := root,var(5)

[State 200, NoType] ; engine rejects
trigger1 = 1

[State 200, EmptyTrigger]
type = Null
trigger1 =

[State 200, NoTrigger1]
type = Null
triggerall = A

[State 200, Unclosed
type = Null
trigger1 = 1

[State 200, AfterUnclosed]
type = Null
trigger1 = B

[State]
type = Null
trigger1 = 1

[State 200, NeverRead]
type = Null
trigger1 = 1

[Statedef -2]
[State -2, NoPersistent]
type = Null
trigger1 = A
persistent = 0

[Statedef const(StateJump)]
type = A

[Statedef 200]
type = S

; Section after a duplicate state
[Remap]
x = y
